# Woolworths NZ credentials
WOOLWORTHS_EMAIL=your@email.com
WOOLWORTHS_PASSWORD=your_password

# Set to "true" to open a visible browser window (useful for debugging)
WOOLWORTHS_HEADLESS=true

# Brave Search API key (get one free at https://brave.com/search/api/)
BRAVE_API_KEY=

# Todoist API token (Settings → Integrations → Developer → API token)
TODOIST_API_KEY=

# Gmail: OAuth credentials are set up via npx @gongrzhe/server-gmail-autoauth-mcp
# Run it once interactively to complete the OAuth flow, then it stores tokens automatically
